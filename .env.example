# From the developer console: https://dzbuild.com/dashboard/developer
DZBUILD_CLIENT_ID=dzapp_0123456789abcdef0123
DZBUILD_CLIENT_SECRET=dzas_replace_me
DZBUILD_SIGNING_SECRET=replace_me_64_hex
# One of the redirect URIs registered on the app, character for character.
DZBUILD_REDIRECT_URI=https://your-host.example/callback
# Space separated; each scope must be registered on the app.
DZBUILD_SCOPES=orders:read
PORT=3000
