{
  "name": "@dzbuild/docs-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives coding agents the DZBuild developer docs, API operations and examples over stdio.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DZBuild-com/dzbuild-app-starter.git",
    "directory": "packages/docs-mcp"
  },
  "homepage": "https://dzbuild.dev/agents/connect",
  "bin": {
